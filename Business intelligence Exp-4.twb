      <aliases enabled='yes' />
      <column caption='Vaccinatin coverage' datatype='real' name='[Calculation_0918118886666240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([population]) != 0 THEN&#13;&#10;    (SUM([people_vaccinated]) / SUM([population])) * 100&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
      </column>
      <column caption='Daily cases growth rate' datatype='real' name='[Calculation_1338407102066689]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([total_cases]) != 0 THEN&#13;&#10;    (SUM([new_cases]) / SUM([total_cases])) * 100&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
      </column>
      <column caption='Case fatality rate' datatype='real' name='[Calculation_1338407102578690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([total_cases]) != 0 THEN&#13;&#10;    SUM([total_deaths]) / SUM([total_cases]) * 100&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
      </column>
      <column caption='Vaccination percentage' datatype='real' name='[Calculation_1338407102959619]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [population] != 0 THEN&#13;&#10;    ([people_fully_vaccinated] / [population]) * 100&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
      </column>
      <column caption='New cases clean' datatype='integer' name='[Calculation_1338407103496196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([new_cases],0)' />
      </column>
      <column caption='Total cases clean' datatype='integer' name='[Calculation_1338407103807493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([total_cases],0)' />
      </column>
