      <aliases enabled='yes' />
      <column caption='Profit margin' datatype='real' name='[Calculation_1281509347393536]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sales]) != 0 THEN&#13;&#10;    (SUM([Profit]) / SUM([Sales])) * 100&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
      </column>
      <column caption='Sales growth' datatype='real' name='[Calculation_1281509347545089]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]), -1))&#13;&#10;/&#13;&#10;ABS(LOOKUP(SUM([Sales]), -1))&#13;&#10;* 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Year to date sales' datatype='real' name='[Calculation_1281509347684354]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Clean Region' datatype='string' name='[Calculation_1281509348761603]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Region]) OR&#13;&#10;   LOWER(TRIM([Region])) = &quot;nan&quot; OR&#13;&#10;   LOWER(TRIM([Region])) = &quot;null&quot; OR&#13;&#10;   TRIM([Region]) = &quot;NaN&quot;&#13;&#10;THEN &quot;Unknown&quot;&#13;&#10;ELSE [Region]&#13;&#10;END' />
      </column>
      <column caption='Clean category' datatype='string' name='[Calculation_1281509349302276]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Category]) OR&#13;&#10;   LOWER(TRIM([Category])) = &quot;Nan&quot; OR&#13;&#10;   LOWER(TRIM([Category])) = &quot;Null&quot; OR&#13;&#10;   TRIM([Category]) = &quot;NaN?&quot;&#13;&#10;THEN &quot;Nan&quot;&#13;&#10;ELSE [Category]&#13;&#10;END' />
      </column>
      <column caption='Selected KPI' datatype='real' name='[Calculation_1281509351026693]' role='measure' type='quantitative'>
