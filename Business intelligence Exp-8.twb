      <aliases enabled='yes' />
      <column caption='Regional Growth %' datatype='real' name='[Calculation_1410709523066880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    SUM(IF YEAR([Order Date]) = 2026 THEN [Sales] END)&#13;&#10;    -&#13;&#10;    SUM(IF YEAR([Order Date]) = 2025 THEN [Sales] END)&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(IF YEAR([Order Date]) = 2025 THEN [Sales] END)' />
      </column>
      <column caption='Growth Target Status' datatype='string' name='[Calculation_1410709523230721]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1410709523066880] &gt;= 0.10 THEN&#13;&#10;    &quot;Above Target&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Below Target&quot;&#13;&#10;END' />
      </column>
      <column caption='Sales Growth %' datatype='real' default-format='p0.00%' name='[Calculation_1455514066030592]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]), -1))&#13;&#10;/&#13;&#10;ABS(LOOKUP(SUM([Sales]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Promotion Duration' datatype='integer' name='[Calculation_1455514066956289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;day&apos;,&#13;&#10;    DATE([Promotion Start Date]),&#13;&#10;    DATE([Promotion End Date])&#13;&#10;) + 1' />
      </column>
